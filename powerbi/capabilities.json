{
  "privileges": [],
  "dataRoles": [
    {
      "displayName": "Date",
      "name": "date",
      "kind": "Grouping",
      "description": "Gregorian Date or DateTime column to filter. The visual validates Date/DateTime at runtime."
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "date": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "date"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1
            }
          }
        }
      }
    }
  ],
  "objects": {
    "general": {
      "displayName": "Filter",
      "properties": {
        "filter": {
          "type": {
            "filter": true
          }
        }
      }
    }
  },
  "supportsLandingPage": true,
  "supportsEmptyDataView": true,
  "supportsSynchronizingFilterState": true,
  "supportsKeyboardFocus": true
}
